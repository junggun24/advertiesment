{
  "name": "sites-project",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "db:init": "wrangler d1 migrations apply oic-korea-db --local --config wrangler.jsonc",
    "db:legacy:init": "node scripts/init-db.mjs",
    "db:migrate:legacy-local": "node scripts/migrate-legacy-to-cloudflare-local.mjs",
    "db:migrate:legacy-remote": "node scripts/migrate-legacy-to-cloudflare-remote.mjs",
    "backup:cloudflare": "node scripts/backup-cloudflare.mjs",
    "test:local": "node scripts/smoke-cloudflare-local.mjs",
    "test:unit": "node --test test/*.test.ts",
    "test:production": "node scripts/smoke-production.mjs",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "lint": "oxlint",
    "format": "oxfmt"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1123.0",
    "@base-ui/react": "1.7.0",
    "@shadcn/react": "0.3.0",
    "@types/pg": "^8.23.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "embla-carousel-react": "8.5.2",
    "exceljs": "^4.4.0",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "pg": "^8.23.0",
    "react": "19.3.0",
    "react-day-picker": "9.8.1",
    "react-dom": "19.3.0",
    "react-resizable-panels": "4.5.8",
    "react-server-dom-webpack": "19.3.0",
    "recharts": "3.8.0",
    "sanitize-html": "^2.17.7",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "vinext": "1.0.0-beta.10"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.56.0",
    "@cloudflare/workers-types": "5.20260921.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/sanitize-html": "^2.16.1",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.35",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "wrangler": "4.135.0"
  },
  "type": "module"
}
